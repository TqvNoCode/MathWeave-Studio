+
+    def _build_solution_steps(
+        self,
+        var: sp.Symbol,
+        dep_var: sp.Symbol,
+        A: sp.Expr,
+        B: sp.Expr,
+        C: sp.Expr,
+        indicial_poly: sp.Expr,
+        delta: sp.Expr,
+        root_case: str,
+        m1: sp.Expr,
+        m2: sp.Expr,
+        alpha: sp.Expr | None,
+        beta: sp.Expr | None,
+        y1_fund: sp.Expr,
+        y2_fund: sp.Expr,
+        W_fund: sp.Expr,
+        is_neg: bool,
+        dom_desc: str,
+        c1_sym: sp.Symbol,
