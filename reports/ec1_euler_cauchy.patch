+                    expression_after=f"{A}*{var}^2*y'' + {B}*{var}*y' + {C}*y = 0",
+                    latex_before=rf"a({var})\,y'' + b({var})\,y' + c({var})\,y = 0",
+                    latex_after=rf"{expr_to_latex(A)}\,{var}^2\,y'' + {expr_to_latex(B)}\,{var}\,y' + {expr_to_latex(C)}\,y = 0",
+                ),
+            )
+        )
+        step_idx += 1
+
