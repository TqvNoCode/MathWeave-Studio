+                )
+            )
+        # Stage 2: Discriminant & Fundamental system
+        elif rn in ("Biệt thức Delta và nghiệm chỉ số", "Hệ nghiệm cơ bản"):
+            p = "Giải phương trình chỉ số và xây dựng hệ nghiệm cơ bản độc lập tuyến tính."
+            mb = "Biệt thức $\\Delta = (B - A)^2 - 4AC$ quyết định dạng nghiệm: hai nghiệm thực phân biệt, nghiệm kép, hoặc cặp nghiệm phức liên hợp."
+            stg_map[2].append(
+                ODEPedagogicalStep(
+                    step_number=orig.step_number,
+                    rule_name=rn,
+                    description=desc,
+                    content=orig.content,
+                    substeps=orig.substeps,
+                    notes=orig.notes,
+                    title=title,
+                    rule_name_vi=orig.rule_name_vi or rn,
+                    equation_latex=raw_eq,
+                    assumptions=orig.assumptions,
+                    purpose=p,
+                    math_basis=mb,
+                    execution=desc,
+                    intermediate_result=raw_eq,
+                    stage_index=2,
+                    stage_name="Nghiệm chỉ số & Hệ nghiệm cơ bản",
