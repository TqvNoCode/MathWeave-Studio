+
+        # Stage 1: Indicial equation setup
+        if rn in ("Nhận dạng dạng phương trình Euler–Cauchy", "Nghiệm thử hàm lũy thừa", "Phương trình chỉ số"):
+            p = "Chuyển phương trình Euler–Cauchy về phương trình chỉ số qua nghiệm thử $y = t^m$."
+            mb = "Phương trình $A t^2 y'' + B t y' + C y = 0$ với nghiệm thử $y = t^m$ dẫn đến $A m(m - 1) + B m + C = 0$."
+            stg_map[1].append(
+                ODEPedagogicalStep(
+                    step_number=orig.step_number,
+                    rule_name=rn,
+                    description=desc,
+                    content=orig.content,
+                    substeps=orig.substeps,
+                    notes=orig.notes,
+                    title=title,
