+            p = "Xác định nghiệm tổng quát và các hằng số tích phân từ điều kiện ban đầu Cauchy (nếu có)."
+            mb = "Tổ hợp tuyến tính $y(t) = C_1 y_1(t) + C_2 y_2(t)$ trên từng khoảng liên thông không chứa điểm kỳ dị $t = 0$."
